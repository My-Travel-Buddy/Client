# Copy this file to ".env" and fill in the values.
#   cp .env.example .env
#
# Vite only exposes variables that start with VITE_, and it bakes them into
# the built JavaScript at BUILD time — so changing one in production means
# rebuilding, not just restarting. Never put a secret in here.

# Where the backend lives.
# Local: http://localhost:8080   Production: your deployed API URL.
VITE_API_URL=http://localhost:8080

# ---------- Auth0 ----------
# Your Auth0 tenant domain — no https://
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com

# The Client ID of your Auth0 SPA application. Public by design: it
# identifies the app, it doesn't authorize anything.
VITE_AUTH0_CLIENT_ID=your-auth0-client-id

# The Identifier of the API you created in Auth0 (Applications > APIs).
# Must be byte-for-byte identical to the backend's AUTH0_AUDIENCE.
VITE_AUTH0_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/
